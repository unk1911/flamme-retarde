# Three.js build cache — build.py downloads these on demand, and the same code
# is already inlined into the committed flamme-retarde.html.
vendor/

# Regenerable geodata. tools/fetch_dem.py and tools/fetch_osm.py pull these
# from AWS Terrarium and Overpass; tools/bake.py turns them into build/payload,
# which *is* committed so the game builds without a network round trip.
build/dem.npy
build/dem_meta.json
build/osm/
build/*_preview.png
build/barrier_debug.png

# The MakeHuman base and the working blends it turns into. The small rigid-part
# blends next to them *are* committed, but these two are 24 MB and 42 MB and are
# rewritten by every full run of tools/blender/human_mh.py, which rebuilds them
# from the .obj it fetches. What has to survive is the exported blob in
# build/payload, and that is committed.
build/mh_base.obj
build/human.blend
build/human_mh.blend

# The morph targets and the bodies they make, for the same reason and by the
# same rule as the base above: 8 MB of .target files that tools/blender/
# mh_morph.py fetches on demand, and 15 MB of .obj it writes from them in about
# a second. What survives is build/payload/bather_*.fr3d.gz.
build/mh_targets/
build/mh_bodies/

# Screenshots and scratch output from tools/shoot.mjs
shots/
*.png
!docs/*.png
!build/payload/*.png
!refs/panels/*.png

# The reference photographs are other people's work — Wikimedia contributors,
# press and stock libraries — gathered locally to model from. They are not ours
# to redistribute, so they stay out of the public repository. tools/gen_panels.py
# needs them only to regenerate the painted panels, and those are committed.
refs/*
!refs/panels/
!refs/README.md
*.blend1

# Python bytecode
__pycache__/
*.pyc

# Burst instance state — live rented-GPU ids, per BURST_STATE. Never tracked.
build/*.json
