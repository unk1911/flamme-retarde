+def _session_user(request) -> str | None:
+    """The signed-in username, trying EVERY ablit_session cookie we were sent.
+
+    `request.cookies` is a dict, so two cookies of the same name collapse into
+    one and which one survives is a coin toss — and two is the normal state of
+    an already-signed-in browser during the cutover, because the old host-only
+    cookie this app used to set sits in the jar next to the new
+    Domain=.edeliverables.com one flamme-auth sets. Reading the raw header and
+    trying them all is the difference between "signed out for no reason" and
+    "signed in", roughly half the time.
+
+    baye.py and flamme-auth's auth.py got the same change in the same release.
+    """
+    for part in (request.headers.get("cookie", "") or "").split(";"):
+        k, _, v = part.strip().partition("=")
+        if k != SESSION_COOKIE or not v:
+            continue
+        u = webauth.read_session(v, SESSION_SECRET)
+        if u:
+            return u
+    return None
 
 
